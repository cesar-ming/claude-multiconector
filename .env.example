# ============================================================
# Conector Marketificial · copia este fichero como .env
# Genera los tres secretos con:  python -m app.cli generar-secretos
# ============================================================

# --- Servicio ---
BASE_URL=https://mcp.marketificial.com
HOSTS_PERMITIDOS=mcp.marketificial.com
API_KEY=
MCP_TOKEN=
CLAVE_CIFRADO=
DB_PATH=datos/conector.db

# --- Salvaguardas (actívalas cuando hayas probado la lectura) ---
PERMITIR_PUBLICAR=false
PERMITIR_GESTIONAR=false
MAX_SUBIDA_PRESUPUESTO_PCT=50
MAX_PRESUPUESTO_DIARIO=500
CADUCIDAD_ACCION_MIN=30

# --- Versiones de API (revisar cada trimestre) ---
META_VERSION=v27.0
GOOGLE_ADS_VERSION=v26
LINKEDIN_VERSION=202610
TIKTOK_ADS_VERSION=v1.3
SHOPIFY_VERSION=2026-10

# --- Meta: Meta Ads + Página de Facebook + Instagram (developers.facebook.com) ---
META_APP_ID=
META_APP_SECRET=
# Vacío = omni_purchase > purchase > offsite_conversion.fb_pixel_purchase (usa uno, nunca los suma)
META_TIPO_CONVERSION=

# --- Google Ads (Google Cloud Console + Centro de API de tu MCC) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_LOGIN_CUSTOMER_ID=

# --- LinkedIn: dos apps separadas (developer.linkedin.com) ---
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
LINKEDIN_CM_CLIENT_ID=
LINKEDIN_CM_CLIENT_SECRET=

# --- TikTok Ads (business-api.tiktok.com) ---
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TIKTOK_METRICA_VALOR=

# --- TikTok orgánico (developers.tiktok.com) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Shopify (dev.shopify.com, Dev Dashboard) ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_orders,read_products,write_products

# --- WordPress: no necesita app; se conecta desde el panel con una contraseña de aplicación ---
