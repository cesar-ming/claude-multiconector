# Copia este archivo (no lo subas a git) o pon estas variables en la config de Claude.
# Solo se activan los conectores cuyas variables obligatorias estén rellenas.

# --- Seguridad ---------------------------------------------------------------
# Herramientas de escritura (publicar, pausar campañas, editar WordPress). Por defecto: desactivadas.
MCP_ALLOW_WRITES=false
MCP_HTTP_TIMEOUT_MS=30000

# --- Modo remoto (HTTP) ---------------------------------------------------------
# MCP_TRANSPORT=http
# MCP_PUBLIC_URL=https://claude-multiconector-xxxx.europe-west1.run.app
# MCP_OWNER_PASSWORD=          # mínimo 12 caracteres
# MCP_TOKEN_SECRET=            # openssl rand -base64 48
# MCP_API_KEY=                 # opcional, para Claude Code: openssl rand -hex 24
# PORT=8080

# --- Google Ads (obligatorias: las 4 primeras) ---------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=      # ID de la MCC si accedes a través de una cuenta de administrador
GOOGLE_ADS_CUSTOMER_ID=            # cuenta por defecto
GOOGLE_ADS_API_VERSION=v22

# --- Meta: Meta Ads + Facebook Pages + Instagram ------------------------------
META_ACCESS_TOKEN=                 # token de usuario del sistema (Business Manager), larga duración
META_AD_ACCOUNT_ID=                # act_1234567890
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=         # ID de la cuenta profesional de IG vinculada a la página
META_API_VERSION=v24.0

# --- LinkedIn: LinkedIn Ads + páginas de empresa ------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=202510        # formato YYYYMM

# --- TikTok Ads (Business API) -------------------------------------------------
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=
TIKTOK_ADS_APP_ID=                 # opcional: habilita tiktok_ads_list_advertisers
TIKTOK_ADS_APP_SECRET=
TIKTOK_ADS_API_VERSION=v1.3

# --- TikTok orgánico (Display API) --------------------------------------------
TIKTOK_ACCESS_TOKEN=               # token de usuario con user.info.basic, user.info.stats, video.list

# --- Shopify -------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=               # mitienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=              # shpat_... (custom app; scopes read_orders, read_products)
SHOPIFY_API_VERSION=2026-10

# --- WordPress -----------------------------------------------------------------
WORDPRESS_SITE_URL=                # https://midominio.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=    # Usuarios → Perfil → Contraseñas de aplicación
